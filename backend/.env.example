# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/read-on-rent
# Or MongoDB Atlas:
#MONGODB_URI=mongodb+srv://readonrent00_db_user:vbNYNE3G9ehmISXD@read-on-rent.hayux7i.mongodb.net/read-on-rent?retryWrites=true&w=majority&appName=Read-On-Rent

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# File Upload
MAX_FILE_SIZE=5242880

# Admin seed credentials (used by seedUsers.js)
ADMIN_EMAIL=admin@readonrent.com
ADMIN_PASSWORD=Admin@12345

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
